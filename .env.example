# Игровые настройки (host, port, координаты, цена сферы) больше НЕ здесь —
# они задаются через телеграм-команды /setup после запуска admin-бота.

# --- Telegram админ-бот (управление всем: /setup, /ah sell, /ah search, капча) ---
ADMIN_BOT_TOKEN=123456:ABC-your-admin-bot-token
# Через запятую — telegram user_id, которым разрешено управлять ботом
ADMIN_WHITELIST=111111111,222222222

# --- Telegram бот пополнения (для клиентов) ---
DEPOSIT_BOT_TOKEN=654321:ABC-your-deposit-bot-token

# --- Общая БД ---
DB_PATH=./data.sqlite

# --- Связь между админ-ботом и игровым ботом ---
GAME_BOT_API_PORT=4000
GAME_BOT_API_TOKEN=change_me_to_random_string

# --- путь к chromium для скриншота капчи (см. README про установку) ---
CHROME_PATH=/usr/bin/chromium-browser
